[Unit]
Description=Rinascita - dashboard trasformazione fisica
Documentation=https://github.com/anticristiancpu/rinascita
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rinascita
Group=rinascita
WorkingDirectory=/opt/rinascita
ExecStart=/usr/bin/python3 -u /opt/rinascita/server.py
Restart=on-failure
RestartSec=5

Environment=RINASCITA_HOST=0.0.0.0
Environment=RINASCITA_PORT=8765
Environment=RINASCITA_DATA=/var/lib/rinascita
Environment=RINASCITA_BACKUP=30
Environment=RINASCITA_BROWSER=0

# il servizio scrive solo nella cartella dei dati
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ReadWritePaths=/var/lib/rinascita

[Install]
WantedBy=multi-user.target
